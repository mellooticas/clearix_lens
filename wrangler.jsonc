{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clearix-lenses",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Segredo (SSO_EXCHANGE_SHARED_SECRET) e variaveis definidas no painel do Cloudflare NAO entram
	// aqui: valor de segredo nunca vai para o repositorio. keep_vars impede que "wrangler deploy"
	// apague o que esta no painel a cada build.
	"keep_vars": true,
	"observability": { "enabled": true }
}
